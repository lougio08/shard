+import type { Data, Shards, Recipes } from "../types/types";
+
+/** Volume d'achat quotidien minimum pour qu'une shard soit utilisable comme composant de craft. */
+export const STABLE_MIN_DAILY_BUY_VOLUME = 5000;
+
+/**
+ * Renvoie l'ensemble des shards dont le volume d'achat quotidien est en dessous du seuil
+ * "Stable". Ne nécessite aucun nouvel appel réseau : `dailyBuyVolumes` est déjà calculée par
+ * ailleurs (ex. DataService.loadDailyBuyVolumes()).
+ */
+export function getUnstableShardIds(dailyBuyVolumes: Record<string, number>): Set<string> {
+  const excluded = new Set<string>();
+  for (const [shardId, volume] of Object.entries(dailyBuyVolumes)) {
+    if (volume < STABLE_MIN_DAILY_BUY_VOLUME) {
+      excluded.add(shardId);
+    }
+  }
+  return excluded;
+}
+
+/**
+ * Renvoie une copie filtrée de `data` où chaque shard de `excludedShardIds` (sauf
+ * `keepShardId`, la shard finale demandée par l'utilisateur) devient totalement
+ * indisponible comme composant de craft :
+ *  - son coût d'achat direct devient infini (rate = 0, voir CalculationService.getDirectCost
+ *    qui renvoie déjà Infinity pour rate <= 0),
+ *  - elle ne peut plus être utilisée comme ingrédient dans aucune recette, pour aucune
+ *    autre shard, à aucun niveau de l'arbre.
+ *
+ * L'algorithme de calcul existant (CalculationService.computeMinCosts), en tournant sur ce
+ * graphe "nettoyé", retrouve alors automatiquement le meilleur chemin restant : c'est
+ * l'équivalent de "essayer les arbres du moins cher au plus cher et prendre le premier
+ * valide", mais en une seule passe, sans énumérer les arbres un par un.
+ */
+export function applyStableFilter(data: Data, excludedShardIds: Set<string>, keepShardId?: string | Set<string>): Data {
+  if (excludedShardIds.size === 0) return data;
+
+  const isKept = (id: string): boolean => {
+    if (!keepShardId) return false;
+    return typeof keepShardId === "string" ? id === keepShardId : keepShardId.has(id);
+  };
+
+  const filteredShards: Shards = {};
+  for (const [id, shard] of Object.entries(data.shards)) {
+    const isExcluded = excludedShardIds.has(id) && !isKept(id);
+    filteredShards[id] = isExcluded ? { ...shard, rate: 0 } : shard;
+  }
+
+  const filteredRecipes: Recipes = {};
+  for (const [output, recipeList] of Object.entries(data.recipes)) {
+    filteredRecipes[output] = recipeList.filter((recipe) => {
+      const [input1, input2] = recipe.inputs;
+      const input1Excluded = excludedShardIds.has(input1) && !isKept(input1);
+      const input2Excluded = excludedShardIds.has(input2) && !isKept(input2);
+      return !input1Excluded && !input2Excluded;
+    });
+  }
+
+  return { shards: filteredShards, recipes: filteredRecipes };
+}
+
+/**
+ * Mémoïsation simple : ne reconstruit une version filtrée de `data` que si l'ensemble des
+ * shards exclues change réellement (ex. après un rafraîchissement des prix), pas à chaque
+ * appel/render. À instancier une fois (ex. useRef ou module-level selon le contexte d'appel).
+ */
+export class StableFilterCache {
+  private lastKey: string | null = null;
+  private lastData: Data | null = null;
+  private lastBaseData: Data | null = null;
+
+  get(baseData: Data, excludedShardIds: Set<string>, keepShardId?: string | Set<string>): Data {
+    const keepKey = typeof keepShardId === "string" ? keepShardId : keepShardId ? [...keepShardId].sort().join(",") : "";
+    const key = `${[...excludedShardIds].sort().join(",")}|${keepKey}`;
+    if (this.lastData && this.lastKey === key && this.lastBaseData === baseData) {
+      return this.lastData;
+    }
+    const filtered = applyStableFilter(baseData, excludedShardIds, keepShardId);
+    this.lastKey = key;
+    this.lastData = filtered;
+    this.lastBaseData = baseData;
+    return filtered;
+  }
+}
